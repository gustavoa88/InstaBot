APP_ENV=development
APP_BIND_HOST=127.0.0.1
ADMIN_API_TOKEN=change-me-admin-token
POSTGRES_DB=contentdb
POSTGRES_USER=contentuser
POSTGRES_PASSWORD=change-me-postgres-password

DATABASE_URL=postgresql://contentuser:change-me-postgres-password@postgres:5432/contentdb
REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=1600
OPENAI_VERBOSITY=low
OPENAI_REASONING_EFFORT=minimal
OPENAI_DAILY_REQUEST_LIMIT=20
OPENAI_CARROSSEL_REQUEST_LIMIT=3
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_DAILY_REQUEST_LIMIT=10
OPENAI_IMAGE_CARROSSEL_REQUEST_LIMIT=2

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=

STORAGE_PATH=/app/storage
PUBLIC_BASE_URL=

MEDIA_RETENTION_DAYS=30
